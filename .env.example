# Copy to .env.local and fill in. Nothing here is required for the site to build:
# every page falls back to the sourced content in lib/site.ts.

# Public site URL, used for canonicals, sitemap, OG tags and RSS.
NEXT_PUBLIC_SITE_URL=https://astheraspace.com

# Sanity. Create a free project at sanity.io/manage, then paste the id here.
# Without these the site still renders and /studio shows a setup notice.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Write token with Editor rights. Only used to store newsletter signups.
SANITY_API_WRITE_TOKEN=

# Resend, for delivering contact and partnership enquiries.
# Verify the sending domain, then set CONTACT_FROM_EMAIL to an address on it.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="ASTHERA site <site@astheraspace.com>"

# Public contact addresses shown on the site and used for form routing.
NEXT_PUBLIC_CONTACT_EMAIL=hello@astheraspace.com
NEXT_PUBLIC_PRESS_EMAIL=press@astheraspace.com
NEXT_PUBLIC_PARTNER_EMAIL=partnerships@astheraspace.com
